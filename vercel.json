{
  "rewrites": [
    {
      "source": "/voice-test",
      "destination": "/voice-test.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=*, gyroscope=*, accelerometer=*, camera=*"
        }
      ]
    }
  ]
}